{
  "name": "power-photo-file-electron",
  "version": "1.0.0",
  "description": "PowerPhotoFile desktop app powered by Electron",
  "main": "main.js",
  "author": "longzhenren",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64",
    "dist:win": "electron-builder --win nsis portable --x64 --arm64"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.longzhenren.powerphotofile",
    "productName": "PowerPhotoFile",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/@img/**/*",
      "node_modules/sharp/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "lib/**/*",
      "README.md",
      "docs/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
